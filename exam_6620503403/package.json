{
  "name": "dw-exam-starter",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate:mysql": "prisma generate --schema prisma/mysql/schema.prisma",
    "db:generate:postgres": "prisma generate --schema prisma/postgres/schema.prisma",
    "db:generate": "pnpm db:generate:mysql && pnpm db:generate:postgres",
    "db:migrate:mysql": "tsx scripts/verify-db-target.ts mysql && prisma migrate dev --schema prisma/mysql/schema.prisma",
    "db:migrate:postgres": "tsx scripts/verify-db-target.ts postgres && prisma migrate dev --schema prisma/postgres/schema.prisma",
    "db:deploy:mysql": "tsx scripts/verify-db-target.ts mysql && prisma migrate deploy --schema prisma/mysql/schema.prisma",
    "db:deploy:postgres": "tsx scripts/verify-db-target.ts postgres && prisma migrate deploy --schema prisma/postgres/schema.prisma",
    "db:seed:mysql": "tsx prisma/mysql/seed.ts",
    "db:seed:postgres": "tsx prisma/postgres/seed.ts",
    "db:verify:mysql": "tsx scripts/verify-db.ts mysql",
    "db:verify:postgres": "tsx scripts/verify-db.ts postgres",
    "db:export": "tsx scripts/export-db.ts",
    "db:import": "tsx scripts/import-db.ts",
    "etl": "tsx scripts/etl.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-parse": "6.1.0",
    "lucide-react": "0.468.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "tailwind-merge": "2.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.2",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.2",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "5.0.5"
  }
}
